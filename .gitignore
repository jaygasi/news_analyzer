# =============================================================================
# Gemini Code Assist: Consolidated .gitignore for 'projects' repository
# This file combines rules from all sub-projects and adds critical new ones.
# =============================================================================

# =============================================================================
# 🔐 SENSITIVE CONFIGURATION & API KEYS
# =============================================================================
.env
.env.*
*.env
.env.local
.environment
env.txt

# Project-specific secret folders/files
c_news/
event/

# Sensitive files by name
config_local.py
config_private.py
secrets.py
api_keys.py
API_URLs.md
api_info.txt


# Backups
*.env.bak
*.env.backup

# =============================================================================
# 💾 DATABASE & CACHE FILES
# =============================================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Cache directories
cache/
.cache/
__pycache__/

# Specific cache files
data/failed_tickers_cache.db
data/fundamentals_cache.db

# =============================================================================
# 📊 OUTPUT, LOGS, & DATA
# =============================================================================

# General data directories
data/
raw_data/
processed_data/
datasets/

# Financial data specific
market_data/
price_data/
earnings_data/
news_data/
api_cache/
fmp_cache/
alpha_vantage_cache/

# Output files
output/
test_output/
test_results/
*.csv
*.xlsx
*.xls

# Log files and directories
logs/
log/
*.log
*.log.*
latest_run_logs.txt

# Archives
*.log.gz
*.log.zip
*.zip
*.tar.gz
*.7z

# =============================================================================
