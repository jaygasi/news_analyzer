# =============================================================================
# Financial News Analysis System - .gitignore
# Protects sensitive data, API keys, databases, logs, and trading outputs
# =============================================================================

# =============================================================================
# 🔐 SENSITIVE CONFIGURATION FILES
# =============================================================================

# Environment files with API keys
.env
.env.*
*.env
.environment
*c_news
c_news/*

# Configuration files that may contain secrets
config_local.py
config_private.py
secrets.py
api_keys.py

# Backup configuration files
*.env.bak
*.env.backup

# =============================================================================
# 💾 DATABASE FILES  
# =============================================================================

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Database-specific files from the project
data/*
data/article_tracking.db
data/failed_tickers_cache.db
data/fundamentals_cache.db
database/*.db

# Database backups and temporary files
*.db-journal
*.db-wal
*.db-shm

# =============================================================================
# 📊 OUTPUT & TRADING DATA
# =============================================================================

# CSV output files with trading decisions/recommendations
output/*.csv
*.csv
trading_decisions*.csv
trading_recommendations*.csv
enhanced_decisions*.csv

# CSV backups
*_backup_*.csv
*backup*.csv

# Excel files with trading data
*.xlsx
*.xls

